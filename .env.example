# Paper mode only. Live mode is refused by config.from_env.
TPB_MODE=paper

# instant | colocated | vps_nearby | home_broadband | home_wifi_poor
# Measured REST round trip from this machine was ~775ms median, so
# home_broadband is OPTIMISTIC here until a WebSocket transport exists.
TPB_LATENCY_PROFILE=home_broadband

# Seeded so two paper runs are comparable across strategy changes.
TPB_LATENCY_SEED=7

TPB_STARTING_BALANCE=1000
TPB_LOG_LEVEL=INFO
