# Paper mode only. Live mode is refused by config.from_env.
TPB_MODE=paper

# instant | colocated | vps_nearby | home_broadband | home_wifi_poor
# Measured REST round trip from this machine was ~775ms median, so
# home_broadband is OPTIMISTIC here until a WebSocket transport exists.
TPB_LATENCY_PROFILE=home_broadband

# Seeded so two paper runs are comparable across strategy changes.
TPB_LATENCY_SEED=7

# Window lengths to trade, in minutes. The venue lists 5m and 15m for the same
# seven assets (BTC ETH SOL XRP DOGE BNB HYPE), on the same 60s TWAP oracle and
# the same fee schedule; 15m carries roughly half the 5m liquidity.
#   5      the original bot, unchanged (the default if this is unset)
#   15     15-minute windows only
#   5,15   both at once -- note the per-epoch risk cap then treats a 15m window
#          and the three 5m windows inside it as ONE correlated bet, which is
#          what they are, so the same money is spread over more markets.
TPB_WINDOW_MINUTES=5

TPB_STARTING_BALANCE=1000
TPB_LOG_LEVEL=INFO

# ---------------------------------------------------------------- real money
# Only read with `python -m troll_poly_bot --live`. Keep this file out of git
# (.env is ignored). --live alone is a DRY RUN; add --armed to post orders.
#
# The private key that SIGNS. Email login: Polymarket profile -> settings -> export private key
# (Magic's reveal page). Its address is the signer, NOT the address on your profile. That is normal.
# TPB_POLY_PRIVATE_KEY=0x...
# The account wallet that HOLDS the funds: the address shown under your Polymarket profile.
# (The older name TPB_POLY_FUNDER still works.) Unset, the SDK derives the signer's Deposit Wallet.
# TPB_POLY_WALLET=0x...
# Optional: lets the bot redeem winners itself. Polymarket app -> Settings -> API Keys -> Relayer
# API Keys; copy the key AND the signer address it shows. Without it, use Auto-Redeem in the app.
# TPB_POLY_RELAYER_API_KEY=
# TPB_POLY_RELAYER_API_KEY_ADDRESS=0x...
# Not needed any more: the venue reports the wallet type (Deposit Wallet, legacy proxy, Safe, plain).
# `python scripts/live_check.py` shows what it sees.
# TPB_POLY_SIGNATURE_TYPE=
# Optional; derived from the key on first run if absent.
# TPB_POLY_API_KEY=
# TPB_POLY_API_SECRET=
# TPB_POLY_API_PASSPHRASE=
# Required to --armed. Spell it out: you are acknowledging real orders.
# TPB_LIVE_ACK=I_UNDERSTAND_REAL_MONEY
